{
  "name": "border-marches",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "assets-check": "tsx src/tools/assetsCheck.ts",
    "pixel-jobs-check": "tsx src/tools/pixelJobsCheck.ts",
    "homm2-assets-check": "tsx src/tools/homm2AssetCheck.ts",
    "map-lint": "tsx src/tools/mapLint.ts",
    "spec-link-check": "tsx src/tools/specLinkCheck.ts",
    "ux-check": "tsx src/tools/uxCheck.ts",
    "pretest": "npm run assets-check && npm run pixel-jobs-check && npm run homm2-assets-check && npm run map-lint && npm run spec-link-check && npm run ux-check",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "sim": "tsx src/sim/cli.ts",
    "review:forest": "tsx src/sim/forest-review.ts",
    "review:landscape": "tsx src/sim/landscape-review.ts",
    "review:mountain": "tsx src/sim/mountain-review.ts",
    "review:mountain-showcase": "tsx src/sim/mountain-showcase.ts",
    "review:terrain-showcase": "tsx src/sim/terrain-showcase.ts",
    "review:combat": "tsx src/sim/combat-review.ts",
    "review:combat:unfinished": "tsx src/sim/combat-review.ts unfinished",
    "review:combat:wound-wrights": "tsx src/sim/combat-review.ts woundWrights",
    "review:combat:vespiary": "tsx src/sim/combat-review.ts vespiary",
    "review:combat:hagwood": "tsx src/sim/combat-review.ts hagwood",
    "review:combat:wildergrass": "tsx src/sim/combat-review.ts wildergrass",
    "review:combat:gloaming-court": "tsx src/sim/combat-review.ts gloamingCourt",
    "review:combat:seamborn": "tsx src/sim/combat-review.ts seamborn",
    "review:combat:driftfolk": "tsx src/sim/combat-review.ts driftfolk",
    "review:interactions": "tsx src/sim/interaction-review.ts",
    "review:ux": "tsx src/sim/ux-review.ts",
    "smoke": "tsx src/sim/browser-smoke.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "puppeteer-core": "^25.4.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
