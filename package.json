{
  "name": "border-marches",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "assets-check": "tsx src/tools/assetsCheck.ts && tsx src/tools/contentIconsCheck.ts && tsx src/tools/spellEffectIconsCheck.ts && tsx src/tools/heroDashboardAssetsCheck.ts",
    "build:hero-dashboard-assets": "tsx scripts/runHeroDashboardAssets.ts build",
    "promote:hero-dashboard-assets": "tsx scripts/runHeroDashboardAssets.ts promote",
    "records:hero-dashboard-assets": "tsx scripts/manageHeroDashboardAssets.ts records",
    "provenance:hero-dashboard-assets": "tsx scripts/manageHeroDashboardAssets.ts provenance",
    "pixel-jobs-check": "tsx src/tools/pixelJobsCheck.ts",
    "homm2-assets-check": "tsx src/tools/homm2AssetCheck.ts",
    "map-lint": "tsx src/tools/mapLint.ts",
    "promote-map": "tsx scripts/promoteMap.ts",
    "spec-link-check": "tsx src/tools/specLinkCheck.ts",
    "ux-check": "tsx src/tools/uxCheck.ts",
    "pretest": "npm run assets-check && npm run pixel-jobs-check && npm run homm2-assets-check && npm run map-lint && npm run spec-link-check && npm run ux-check",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "sim": "tsx src/sim/cli.ts",
    "calibrate:guardian-strength": "tsx src/sim/guardian-strength-calibration.ts --check",
    "calibrate:guardian-strength:print": "tsx src/sim/guardian-strength-calibration.ts",
    "review:forest": "tsx src/sim/forest-review.ts",
    "review:landscape": "tsx src/sim/landscape-review.ts",
    "review:mountain": "tsx src/sim/mountain-review.ts",
    "review:mountain-showcase": "tsx src/sim/mountain-showcase.ts",
    "review:terrain-showcase": "tsx src/sim/terrain-showcase.ts",
    "review:adventure-showcase": "tsx src/sim/adventure-showcase.ts",
    "review:content-icons": "tsx src/sim/content-icon-review.ts",
    "review:item-sprites": "tsx src/sim/item-sprite-review.ts",
    "review:artifact-sprites": "tsx src/sim/artifact-sprite-review.ts",
    "review:spellbook": "tsx src/sim/spellbook-review.ts",
    "review:combat": "tsx src/sim/combat-review.ts",
    "review:combat:unfinished": "tsx src/sim/combat-review.ts unfinished",
    "review:combat:wound-wrights": "tsx src/sim/combat-review.ts woundWrights",
    "review:combat:vespiary": "tsx src/sim/combat-review.ts vespiary",
    "review:combat:hagwood": "tsx src/sim/combat-review.ts hagwood",
    "review:combat:wildergrass": "tsx src/sim/combat-review.ts wildergrass",
    "review:combat:gloaming-court": "tsx src/sim/combat-review.ts gloamingCourt",
    "review:combat:seamborn": "tsx src/sim/combat-review.ts seamborn",
    "review:combat:driftfolk": "tsx src/sim/combat-review.ts driftfolk",
    "review:interactions": "tsx src/sim/interaction-review.ts",
    "review:ux": "tsx src/sim/ux-review.ts",
    "review:castle-transfer": "tsx src/sim/castle-transfer-review.ts",
    "review:hero-meeting": "tsx src/sim/hero-meeting-review.ts",
    "review:incremental-fog": "tsx src/sim/incremental-fog-review.ts",
    "review:setup-save": "tsx src/sim/setup-save-review.ts",
    "review:service-actions": "tsx src/sim/service-action-review.ts",
    "review:combat-targeting": "tsx src/sim/combat-targeting-review.ts",
    "review:campaign-outcomes": "tsx src/sim/campaign-outcome-review.ts",
    "review:crooked-crown": "tsx src/sim/crooked-crown-review.ts",
    "review:sixfold-trial": "tsx src/sim/sixfold-trial-review.ts",
    "review:map-editor": "tsx src/sim/map-editor-review.ts",
    "review:walkthrough": "tsx src/sim/new-player-walkthrough.ts",
    "review:acceptance": "npm run review:setup-save && npm run review:service-actions && npm run review:combat-targeting && npm run review:campaign-outcomes && npm run review:ux && npm run review:walkthrough",
    "smoke": "tsx src/sim/browser-smoke.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "puppeteer-core": "^25.4.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
